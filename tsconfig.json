{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/api/*": ["src/api/*"],
      "@/pages/*": ["src/pages/*"],
      "@/fixtures/*": ["src/fixtures/*"],
      "@/core/*": ["src/core/*"],
      "@/helpers/*": ["src/helpers/*"],
      "@/config/*": ["config/*"],
      "@/types/*": ["src/types/*"]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*", "tests/**/*", "config/**/*", "playwright.config.ts"],
  "exclude": ["node_modules", "test-results", "playwright-report"]
}
