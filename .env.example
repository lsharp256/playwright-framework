# Environment Identifier: dev | staging | prod | local
TEST_ENV=dev

# Application Base URLs
BASE_URL=https://automationexercise.com
API_URL=https://dummyjson.com

# Authentication Credentials
ADMIN_EMAIL=admin@framework.test
ADMIN_PASSWORD=FrameworkAdmin123!
STANDARD_USER_EMAIL=user@framework.test
STANDARD_USER_PASSWORD=StandardUser123!

# Test Execution Settings
HEADLESS=true
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000
RETRIES=1
WORKERS=4

# Logging & Debugging
LOG_LEVEL=info
CAPTURE_HAR=false
# Performance & Load Testing
LOAD_TEST_VUS=10
LOAD_TEST_DURATION=20
LOAD_TEST_RAMP_UP=5
LOAD_TEST_SLA_P95_MS=1000
LOAD_TEST_SLA_ERROR_RATE=1.0

# CI/CD Notifications & Reporting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK
SLACK_CHANNEL=#qa-automation-alerts
NOTIFY_ON_FAILURE_ONLY=false
HISTORY_RETENTION_RUNS=50
