# Environment Identifier: dev | staging | prod | local
TEST_ENV=dev

# Application Base URLs
BASE_URL=https://automationexercise.com
API_URL=https://dummyjson.com

# Authentication Credentials
ADMIN_EMAIL=admin@framework.test
ADMIN_PASSWORD=FrameworkAdmin123!
STANDARD_USER_EMAIL=user@framework.test
STANDARD_USER_PASSWORD=StandardUser123!

# Test Execution Settings
HEADLESS=true
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=10000
RETRIES=1
WORKERS=4

# Logging & Debugging
LOG_LEVEL=info
CAPTURE_HAR=false
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
